PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=jobhunt_db
JWT_SECRET=your_super_secret_key_min_32_chars
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
# Optional: pool size, remote-TLS behavior (TLS on by default off localhost).
# DB_POOL_LIMIT=5
# DB_SSL_DISABLED=true
# DB_SSL_STRICT=true
# Optional: Turso (libSQL) instead of MySQL. When set, TURSO_* wins over DB_*.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your_turso_token
